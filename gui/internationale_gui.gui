window = {
	name = "internationale_gui_trigger"
	parentanchor = hcenter|vcenter
	size = { 1280 960 }
	layer = windows_layer
	filter_mouse = all
	allow_outside = yes
	alwaystransparent = no

	visible = "[GetVariableSystem.Exists('internationale_open')]"
	datacontext = "[GetPlayer]"

	background = {
		using = paper_bg
	}

	vbox = {
		layoutpolicy_horizontal = expanding
		layoutpolicy_vertical = expanding

		### HEADER
		hbox = {
			layoutpolicy_horizontal = expanding
			minimumsize = { 0 54 }

			background = {
				using = default_header_bg
			}

			margin = { 14 0 }
			spacing = 10

			icon = {
				size = { 28 28 }
				parentanchor = vcenter
				texture = "gfx/interface/icons/generic_icons/identity_overlay.dds"
				color = { 0.88 0.78 0.32 1 }
			}

			textbox = {
				layoutpolicy_horizontal = expanding
				size = { 0 54 }
				text = "intl_parliament_title"
				using = fontsize_xxl
				align = left|nobaseline
				parentanchor = vcenter
			}
		}

		### SUBTITLE
		widget = {
			layoutpolicy_horizontal = expanding
			size = { 0 36 }

			background = {
				using = dark_area
				alpha = 0.4
			}

			textbox = {
				size = { 100% 100% }
				text = "intl_parliament_desc"
				using = fontsize_medium
				align = hcenter|nobaseline
				parentanchor = center
				alpha = 0.8
			}
		}

		divider_clean = {
			layoutpolicy_horizontal = expanding
		}

		### SPACER
		widget = { size = { 0 8 } }

		### PARLIAMENT GRAPH
		widget = {
			layoutpolicy_horizontal = expanding
			size = { 0 290 }
			background = {
						texture = "gfx/interface/backgrounds/bg_internationale.dds"
						size = { 90% 90% }
						margin_left = -10
						margin_right = -10
					}
			using = tooltip_below
			tooltip = "intl_parliament_tooltip"

			margin = { 10 5 }

			container = {
					visible = "[GetPlayer.MakeScope.Var('ISideologyleader_scope_gui').IsSet]"
					datacontext = "[GetPlayer.MakeScope.Var('ideologyleader_scope_gui').GetCharacter]"
					parentanchor = left
					size = { 90% 90% }
					position = { 25 -50 }
					flowcontainer = {
						
						direction = vertical
						character_portrait_front_vs_left = {
							position = { 0 0 }
							parentanchor = hcenter
							blockoverride "highlight" {}
							blockoverride "commander_order_icon" {}
						}
						
					}
				}
			hbox = {
				layoutpolicy_horizontal = expanding
				size = { 100% 280 }

				widget = {
					size = { 0 1 }
					layoutpolicy_horizontal = expanding
				}

				widget = {
					size = { 600 280 }

					intl_parliament_visual_anarchist = {}
					intl_parliament_visual_mutualist = {}
					intl_parliament_visual_syndicalist = {}
					intl_parliament_visual_blanquist = {}
					intl_parliament_visual_marxist = {}
				}

				widget = {
					size = { 0 1 }
					layoutpolicy_horizontal = expanding
				}
			}

		}

		### SPACER
		widget = { size = { 0 6 } }

		### DELEGATES LABEL
		widget = {
			layoutpolicy_horizontal = expanding
			size = { 0 26 }

			background = {
				using = dark_area
				alpha = 0.1
			}

			textbox = {
				size = { 100% 100% }
				text = "intl_delegates_label"
				using = fontsize_small
				align = hcenter|nobaseline
				parentanchor = center
				alpha = 0.45
			}
		}

		### FACTION TAB BUTTONS
		hbox = {
			layoutpolicy_horizontal = expanding
			size = { 0 30 }
			spacing = 2
			margin = { 8 0 }

			### CURRENT MOTION TAB
			intl_tab_button = {
				blockoverride "tab_color" {
					color = { 0.55 0.48 0.28 1 }
				}
				blockoverride "tab_text" {
					text = "intl_tab_current_motion"
				}
				blockoverride "tab_active_visible" {
					visible = "[Not(Or(Or(Or(Or(GetVariableSystem.Exists('intl_tab_anarchist'), GetVariableSystem.Exists('intl_tab_mutualist')), GetVariableSystem.Exists('intl_tab_syndicalist')), GetVariableSystem.Exists('intl_tab_blanquist')), GetVariableSystem.Exists('intl_tab_marxist')))]"
				}
				blockoverride "tab_inactive_visible" {
					visible = "[Or(Or(Or(Or(GetVariableSystem.Exists('intl_tab_anarchist'), GetVariableSystem.Exists('intl_tab_mutualist')), GetVariableSystem.Exists('intl_tab_syndicalist')), GetVariableSystem.Exists('intl_tab_blanquist')), GetVariableSystem.Exists('intl_tab_marxist'))]"
				}
				blockoverride "tab_onclick_set" {
					onclick = "[GetVariableSystem.Clear('intl_tab_anarchist')]"
					onclick = "[GetVariableSystem.Clear('intl_tab_mutualist')]"
					onclick = "[GetVariableSystem.Clear('intl_tab_syndicalist')]"
					onclick = "[GetVariableSystem.Clear('intl_tab_blanquist')]"
					onclick = "[GetVariableSystem.Clear('intl_tab_marxist')]"
				}
				blockoverride "tab_onclick_clear" {
				}
			}

			intl_tab_button = {
				blockoverride "tab_color" {
					color = { 0.15 0.15 0.15 1 }
				}
				blockoverride "tab_text" {
					text = "intl_faction_anarchist"
				}
				blockoverride "tab_active_visible" {
					visible = "[GetVariableSystem.Exists('intl_tab_anarchist')]"
				}
				blockoverride "tab_inactive_visible" {
					visible = "[Not(GetVariableSystem.Exists('intl_tab_anarchist'))]"
				}
				blockoverride "tab_onclick_set" {
					onclick = "[GetVariableSystem.Clear('intl_tab_mutualist')]"
					onclick = "[GetVariableSystem.Clear('intl_tab_syndicalist')]"
					onclick = "[GetVariableSystem.Clear('intl_tab_blanquist')]"
					onclick = "[GetVariableSystem.Clear('intl_tab_marxist')]"
					onclick = "[GetVariableSystem.Set('intl_tab_anarchist', 'true')]"
				}
				blockoverride "tab_onclick_clear" {
					onclick = "[GetVariableSystem.Clear('intl_tab_anarchist')]"
				}
			}

			intl_tab_button = {
				blockoverride "tab_color" {
					color = { 0.9 0.6 0.1 1 }
				}
				blockoverride "tab_text" {
					text = "intl_faction_mutualist"
				}
				blockoverride "tab_active_visible" {
					visible = "[GetVariableSystem.Exists('intl_tab_mutualist')]"
				}
				blockoverride "tab_inactive_visible" {
					visible = "[Not(GetVariableSystem.Exists('intl_tab_mutualist'))]"
				}
				blockoverride "tab_onclick_set" {
					onclick = "[GetVariableSystem.Clear('intl_tab_anarchist')]"
					onclick = "[GetVariableSystem.Clear('intl_tab_syndicalist')]"
					onclick = "[GetVariableSystem.Clear('intl_tab_blanquist')]"
					onclick = "[GetVariableSystem.Clear('intl_tab_marxist')]"
					onclick = "[GetVariableSystem.Set('intl_tab_mutualist', 'true')]"
				}
				blockoverride "tab_onclick_clear" {
					onclick = "[GetVariableSystem.Clear('intl_tab_mutualist')]"
				}
			}

			intl_tab_button = {
				blockoverride "tab_color" {
					color = { 0.8 0.15 0.15 1 }
				}
				blockoverride "tab_text" {
					text = "intl_faction_syndicalist"
				}
				blockoverride "tab_active_visible" {
					visible = "[GetVariableSystem.Exists('intl_tab_syndicalist')]"
				}
				blockoverride "tab_inactive_visible" {
					visible = "[Not(GetVariableSystem.Exists('intl_tab_syndicalist'))]"
				}
				blockoverride "tab_onclick_set" {
					onclick = "[GetVariableSystem.Clear('intl_tab_anarchist')]"
					onclick = "[GetVariableSystem.Clear('intl_tab_mutualist')]"
					onclick = "[GetVariableSystem.Clear('intl_tab_blanquist')]"
					onclick = "[GetVariableSystem.Clear('intl_tab_marxist')]"
					onclick = "[GetVariableSystem.Set('intl_tab_syndicalist', 'true')]"
				}
				blockoverride "tab_onclick_clear" {
					onclick = "[GetVariableSystem.Clear('intl_tab_syndicalist')]"
				}
			}

			intl_tab_button = {
				blockoverride "tab_color" {
					color = { 0.2 0.3 0.7 1 }
				}
				blockoverride "tab_text" {
					text = "intl_faction_blanquist"
				}
				blockoverride "tab_active_visible" {
					visible = "[GetVariableSystem.Exists('intl_tab_blanquist')]"
				}
				blockoverride "tab_inactive_visible" {
					visible = "[Not(GetVariableSystem.Exists('intl_tab_blanquist'))]"
				}
				blockoverride "tab_onclick_set" {
					onclick = "[GetVariableSystem.Clear('intl_tab_anarchist')]"
					onclick = "[GetVariableSystem.Clear('intl_tab_mutualist')]"
					onclick = "[GetVariableSystem.Clear('intl_tab_syndicalist')]"
					onclick = "[GetVariableSystem.Clear('intl_tab_marxist')]"
					onclick = "[GetVariableSystem.Set('intl_tab_blanquist', 'true')]"
				}
				blockoverride "tab_onclick_clear" {
					onclick = "[GetVariableSystem.Clear('intl_tab_blanquist')]"
				}
			}

			intl_tab_button = {
				blockoverride "tab_color" {
					color = { 0.55 0.2 0.6 1 }
				}
				blockoverride "tab_text" {
					text = "intl_faction_marxist"
				}
				blockoverride "tab_active_visible" {
					visible = "[GetVariableSystem.Exists('intl_tab_marxist')]"
				}
				blockoverride "tab_inactive_visible" {
					visible = "[Not(GetVariableSystem.Exists('intl_tab_marxist'))]"
				}
				blockoverride "tab_onclick_set" {
					onclick = "[GetVariableSystem.Clear('intl_tab_anarchist')]"
					onclick = "[GetVariableSystem.Clear('intl_tab_mutualist')]"
					onclick = "[GetVariableSystem.Clear('intl_tab_syndicalist')]"
					onclick = "[GetVariableSystem.Clear('intl_tab_blanquist')]"
					onclick = "[GetVariableSystem.Set('intl_tab_marxist', 'true')]"
				}
				blockoverride "tab_onclick_clear" {
					onclick = "[GetVariableSystem.Clear('intl_tab_marxist')]"
				}
			}
		}

		divider_clean = {
			layoutpolicy_horizontal = expanding
		}

		### CHARACTER CARDS ROW
		hbox = {
			layoutpolicy_horizontal = expanding
			size = { 0 118 }
			spacing = 2
			margin = { 8 0 }

			intl_faction_card = {
				blockoverride "card_color" {
					color = { 0.15 0.15 0.15 1 }
				}
				blockoverride "card_portrait" {
					character_portrait_small2 = {
						position = { 0 35 }
						parentanchor = vcenter
						datacontext = "[GetPlayer.MakeScope.Var('bakunin_scope_gui').GetCharacter]"
						blockoverride "show_hat" {}
						blockoverride "highlight" {}
					}
				}

				blockoverride "card_delegate" { text = "intl_delegate_anarchist_name" }
				blockoverride "card_role" { text = "intl_delegate_anarchist_role" }
				blockoverride "card_active_visible" {
					visible = "[GetVariableSystem.Exists('intl_tab_anarchist')]"
				}
				blockoverride "card_inactive_visible" {
					visible = "[Not(GetVariableSystem.Exists('intl_tab_anarchist'))]"
				}
				blockoverride "card_onclick_set" {
					onclick = "[GetVariableSystem.Clear('intl_tab_mutualist')]"
					onclick = "[GetVariableSystem.Clear('intl_tab_syndicalist')]"
					onclick = "[GetVariableSystem.Clear('intl_tab_blanquist')]"
					onclick = "[GetVariableSystem.Clear('intl_tab_marxist')]"
					onclick = "[GetVariableSystem.Set('intl_tab_anarchist', 'true')]"
				}
				blockoverride "card_onclick_clear" {
					onclick = "[GetVariableSystem.Clear('intl_tab_anarchist')]"
				}
			}

			intl_faction_card = {
				parentanchor = center|left
				blockoverride "card_color" {
					color = { 0.9 0.6 0.1 1 }
				}
				blockoverride "card_portrait" {
					character_portrait_small2 = {
						position = { 0 35 }
						parentanchor = vcenter
						datacontext = "[GetPlayer.MakeScope.Var('proudhon_scope_gui').GetCharacter]"
						blockoverride "show_hat" {}
						blockoverride "highlight" {}
					}
				}

				blockoverride "card_delegate" { text = "intl_delegate_mutualist_name" }
				blockoverride "card_role" { text = "intl_delegate_mutualist_role" }
				blockoverride "card_active_visible" {
					visible = "[GetVariableSystem.Exists('intl_tab_mutualist')]"
				}
				blockoverride "card_inactive_visible" {
					visible = "[Not(GetVariableSystem.Exists('intl_tab_mutualist'))]"
				}
				blockoverride "card_onclick_set" {
					onclick = "[GetVariableSystem.Clear('intl_tab_anarchist')]"
					onclick = "[GetVariableSystem.Clear('intl_tab_syndicalist')]"
					onclick = "[GetVariableSystem.Clear('intl_tab_blanquist')]"
					onclick = "[GetVariableSystem.Clear('intl_tab_marxist')]"
					onclick = "[GetVariableSystem.Set('intl_tab_mutualist', 'true')]"
				}
				blockoverride "card_onclick_clear" {
					onclick = "[GetVariableSystem.Clear('intl_tab_mutualist')]"
				}
			}

			intl_faction_card = {
				blockoverride "card_color" {
					color = { 0.8 0.15 0.15 1 }
				}
				blockoverride "card_portrait" {
					character_portrait_small2 = {
						position = { 0 35 }
						parentanchor = vcenter
						datacontext = "[GetPlayer.MakeScope.Var('bel_de_paepe_scope_gui').GetCharacter]"
						blockoverride "show_hat" {}
						blockoverride "highlight" {}
					}
				}

				blockoverride "card_delegate" { text = "intl_delegate_syndicalist_name" }
				blockoverride "card_role" { text = "intl_delegate_syndicalist_role" }
				blockoverride "card_active_visible" {
					visible = "[GetVariableSystem.Exists('intl_tab_syndicalist')]"
				}
				blockoverride "card_inactive_visible" {
					visible = "[Not(GetVariableSystem.Exists('intl_tab_syndicalist'))]"
				}
				blockoverride "card_onclick_set" {
					onclick = "[GetVariableSystem.Clear('intl_tab_anarchist')]"
					onclick = "[GetVariableSystem.Clear('intl_tab_mutualist')]"
					onclick = "[GetVariableSystem.Clear('intl_tab_blanquist')]"
					onclick = "[GetVariableSystem.Clear('intl_tab_marxist')]"
					onclick = "[GetVariableSystem.Set('intl_tab_syndicalist', 'true')]"
				}
				blockoverride "card_onclick_clear" {
					onclick = "[GetVariableSystem.Clear('intl_tab_syndicalist')]"
				}
			}

			intl_faction_card = {
				blockoverride "card_color" {
					color = { 0.2 0.3 0.7 1 }
				}
				blockoverride "card_portrait" {
					character_portrait_small2 = {
						position = { 0 35 }
						parentanchor = vcenter
						datacontext = "[GetPlayer.MakeScope.Var('blanqui_scope_gui').GetCharacter]"
						blockoverride "show_hat" {}
						blockoverride "highlight" {}
					}
				}

				blockoverride "card_delegate" { text = "intl_delegate_blanquist_name" }
				blockoverride "card_role" { text = "intl_delegate_blanquist_role" }
				blockoverride "card_active_visible" {
					visible = "[GetVariableSystem.Exists('intl_tab_blanquist')]"
				}
				blockoverride "card_inactive_visible" {
					visible = "[Not(GetVariableSystem.Exists('intl_tab_blanquist'))]"
				}
				blockoverride "card_onclick_set" {
					onclick = "[GetVariableSystem.Clear('intl_tab_anarchist')]"
					onclick = "[GetVariableSystem.Clear('intl_tab_mutualist')]"
					onclick = "[GetVariableSystem.Clear('intl_tab_syndicalist')]"
					onclick = "[GetVariableSystem.Clear('intl_tab_marxist')]"
					onclick = "[GetVariableSystem.Set('intl_tab_blanquist', 'true')]"
				}
				blockoverride "card_onclick_clear" {
					onclick = "[GetVariableSystem.Clear('intl_tab_blanquist')]"
				}
			}

			intl_faction_card = {
				blockoverride "card_color" {
					color = { 0.55 0.2 0.6 1 }
				}
				blockoverride "card_portrait" {
					character_portrait_small2 = {
						position = { 0 35 }
						parentanchor = vcenter
						datacontext = "[GetPlayer.MakeScope.Var('karl_marx_scope_gui').GetCharacter]"
						blockoverride "show_hat" {}
						blockoverride "highlight" {}
					}
				}

				blockoverride "card_delegate" { text = "intl_delegate_marxist_name" }
				blockoverride "card_role" { text = "intl_delegate_marxist_role" }
				blockoverride "card_active_visible" {
					visible = "[GetVariableSystem.Exists('intl_tab_marxist')]"
				}
				blockoverride "card_inactive_visible" {
					visible = "[Not(GetVariableSystem.Exists('intl_tab_marxist'))]"
				}
				blockoverride "card_onclick_set" {
					onclick = "[GetVariableSystem.Clear('intl_tab_anarchist')]"
					onclick = "[GetVariableSystem.Clear('intl_tab_mutualist')]"
					onclick = "[GetVariableSystem.Clear('intl_tab_syndicalist')]"
					onclick = "[GetVariableSystem.Clear('intl_tab_blanquist')]"
					onclick = "[GetVariableSystem.Set('intl_tab_marxist', 'true')]"
				}
				blockoverride "card_onclick_clear" {
					onclick = "[GetVariableSystem.Clear('intl_tab_marxist')]"
				}
			}
		}

		### DETAIL SECTION (scrollable, expands to fill remaining space)
		scrollarea = {
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding
			minimumsize = { 0 90 }
			scrollbarpolicy_horizontal = always_off

			scrollwidget = {
				flowcontainer = {
					parentanchor = left|top
					direction = vertical
					layoutpolicy_horizontal = expanding
					spacing = 4
					margin = { 8 6 }

					### CURRENT MOTION — no active vote
					widget = {
						layoutpolicy_horizontal = expanding
						size = { 0 180 }
						visible = "[And(Not(Or(Or(Or(Or(GetVariableSystem.Exists('intl_tab_anarchist'), GetVariableSystem.Exists('intl_tab_mutualist')), GetVariableSystem.Exists('intl_tab_syndicalist')), GetVariableSystem.Exists('intl_tab_blanquist')), GetVariableSystem.Exists('intl_tab_marxist'))), Not(GetGlobalVariable('intl_vote_active').IsSet))]"

						background = {
							using = entry_bg_fancy
							alpha = 0.3
						}

						vbox = {
							parentanchor = center
							spacing = 8
							textbox = {
								size = { 700 40 }
								text = "intl_no_current_motion"
								using = fontsize_large
								align = hcenter|nobaseline
								parentanchor = hcenter
								alpha = 0.6
							}
							textbox = {
								size = { 700 30 }
								text = "intl_no_current_motion_hint"
								using = fontsize_small
								align = hcenter|nobaseline
								parentanchor = hcenter
								alpha = 0.4
							}
						}
					}

					### CURRENT MOTION — active vote interface
					widget = {
						layoutpolicy_horizontal = expanding
						size = { 0 310 }
						visible = "[And(Not(Or(Or(Or(Or(GetVariableSystem.Exists('intl_tab_anarchist'), GetVariableSystem.Exists('intl_tab_mutualist')), GetVariableSystem.Exists('intl_tab_syndicalist')), GetVariableSystem.Exists('intl_tab_blanquist')), GetVariableSystem.Exists('intl_tab_marxist'))), GetGlobalVariable('intl_vote_active').IsSet)]"

						hbox = {
							layoutpolicy_horizontal = expanding
							spacing = 8
							margin = { 10 8 }

							### LEFT — current law
							widget = {
								size = { 350 290 }
								background = { using = entry_bg_fancy alpha = 0.4 }
								vbox = {
									parentanchor = center
									spacing = 8
									margin = { 10 10 }
									textbox = {
										size = { 320 28 }
										text = "intl_vote_current_label"
										using = fontsize_medium
										align = hcenter|nobaseline
										alpha = 0.7
									}
									textbox = {
										size = { 320 60 }
										text = "intl_vote_law_name_placeholder"
										using = fontsize_large
										align = hcenter|nobaseline
									}
									textbox = {
										size = { 320 28 }
										text = "intl_vote_count_current_label"
										using = fontsize_small
										align = hcenter|nobaseline
										alpha = 0.6
									}
									button_standard = {
										size = { 220 36 }
										parentanchor = hcenter
										text = "intl_vote_keep_button"
									}
								}
							}

							### CENTER — status
							widget = {
								size = { 160 290 }
								vbox = {
									parentanchor = center
									spacing = 10
									textbox = {
										size = { 140 50 }
										text = "VS"
										using = fontsize_xxl
										align = hcenter|nobaseline
										alpha = 0.5
									}
									progressbar = {
										size = { 140 20 }
										value = "[GetGlobalVariable('intl_vote_prestige_current').GetValue(int32)]"
										max = "[Add(GetGlobalVariable('intl_vote_prestige_current').GetValue(int32), GetGlobalVariable('intl_vote_prestige_proposed').GetValue(int32))]"
									}
									textbox = {
										size = { 140 24 }
										text = "intl_vote_months_left_label"
										using = fontsize_small
										align = hcenter|nobaseline
									}
								}
							}

							### RIGHT — proposed law
							widget = {
								size = { 350 290 }
								background = { using = entry_bg_fancy alpha = 0.4 }
								vbox = {
									parentanchor = center
									spacing = 8
									margin = { 10 10 }
									textbox = {
										size = { 320 28 }
										text = "intl_vote_proposed_label"
										using = fontsize_medium
										align = hcenter|nobaseline
										alpha = 0.7
									}
									textbox = {
										size = { 320 60 }
										text = "intl_vote_law_name_placeholder"
										using = fontsize_large
										align = hcenter|nobaseline
									}
									textbox = {
										size = { 320 28 }
										text = "intl_vote_count_proposed_label"
										using = fontsize_small
										align = hcenter|nobaseline
										alpha = 0.6
									}
									button_standard = {
										size = { 220 36 }
										parentanchor = hcenter
										text = "intl_vote_support_button"
									}
								}
							}
						}
					}					}


					### Anarchist doctrine
					intl_faction_detail_panel = {
						blockoverride "parentanchor" {
							parentanchor = right
						}
						visible = "[GetVariableSystem.Exists('intl_tab_anarchist')]"
						blockoverride "detail_color" { color = { 0.15 0.15 0.15 1 } }
						blockoverride "detail_faction_name" { text = "intl_faction_anarchist" }
						blockoverride "detail_title" { text = "intl_delegate_anarchist_title" }
						blockoverride "detail_desc" { text = "intl_doctrine_anarchist" }
						blockoverride "detail_laws" {
